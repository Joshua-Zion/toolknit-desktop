{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "toolknit-desktop",
  "version": "1.0.0",
  "identifier": "com.toolknit.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ToolKnit Desktop",
        "width": 1100,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 800,
        "maxWidth": 1100,
        "maxHeight": 800,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "shadow": false,
        "devtools": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: blob: data: https://cdn.24picture.com https://toolknitapi.24picture.com https://pic1.imgdb.cn; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://toolknitapi.24picture.com https://toolknit.com https://cdn.24picture.com https://toolknit.cn-nb1.rains3.com https://api.deepseek.com https://api.openai.com https://dashscope.aliyuncs.com https://api.moonshot.cn; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$DOCUMENT/*", "$DOWNLOAD/*", "$APPDATA/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/icon.ico",
        "languages": ["English", "SimpChinese"],
        "displayLanguageSelector": true,
        "template": "./windows/installer.nsi",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}

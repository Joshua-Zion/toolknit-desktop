PORT=3000
NODE_ENV=production

# 外部访问地址（用于头像 URL 拼接，必须设置）
BASE_URL=https://your-domain.com

# MySQL 配置（宝塔创建的数据库信息）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=toolknit
DB_USER=toolknit
DB_PASSWORD=你的数据库密码

# JWT 密钥（务必改成随机长字符串）
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_LONG_STRING_!@#$%^&*()
JWT_EXPIRES_IN=7d

# Free 用户每日使用上限
DAILY_LIMIT_FREE=500

# 上传限制
MAX_AVATAR_SIZE_MB=2

# Cloudflare R2（upload-r2.js 脚本用）
R2_ACCOUNT_ID=你的R2账户ID
R2_ACCESS_KEY_ID=你的R2 Access Key ID
R2_SECRET_ACCESS_KEY=你的R2 Secret Access Key
R2_BUCKET=toolknit
ZIP_PATH=toolknit-desktop.zip

# CORS 允许的来源（逗号分隔，* 表示全部允许）
CORS_ORIGIN=https://your-domain.com
